{
  "name": "@naskot/node-pino-runtime-logger",
  "version": "0.1.0",
  "description": "Agnostic runtime logger service built on pino with optional PM2-aware behavior.",
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-pino-runtime-logger"
  },
  "homepage": "https://github.com/padcmoi/node-pino-runtime-logger",
  "bugs": {
    "url": "https://github.com/padcmoi/node-pino-runtime-logger/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "ci": "npm ci && npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "pino",
    "logger",
    "pm2",
    "node"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
